---
import AudioControls from '../features/audio-experience/AudioControls.astro';
import Guitar from '../features/interactive-guitar/Guitar.astro';
import StringNav from '../features/interactive-guitar/StringNav.astro';
import ProfilePanel from '../features/profile/ProfilePanel.astro';
import {
  description,
  displayName,
  guitarCaption,
  headline,
  links,
  pageTitle,
  tagline,
} from '../features/profile/profile';
import styles from '../styles/home.module.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical: string = new URL(base, Astro.site).href;
const linkedIn: string = links.find((link) => link.label === 'LinkedIn')?.href ?? '';
const person: string = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  jobTitle: 'Frontend Tech Lead',
  worksFor: { '@type': 'Organization', name: 'EPAM Systems' },
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  url: canonical,
  sameAs: links.map((link) => link.href),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={person} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-V3TGD1L0Z4');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V3TGD1L0Z4"></script>
  </head>
  <body>
    <a class={styles.skip} href="#profile">Skip to profile</a>
    <main class={styles.page} style={`--background-image: url('${base}img/home.jpeg')`}>
      <div class={styles.instrument}>
        <Guitar />
        <p class={styles.caption}>{guitarCaption}</p>
        <AudioControls />
      </div>
      <StringNav />
      <div class={styles.content}>
        <header>
          <p class={styles.kicker}>{headline}</p>
          <h1 class={styles.title}>Antonio<br />Ospina</h1>
          <p class={styles.tagline}>{tagline}</p>
          <ul class={styles.ctas}>
            <li><a class:list={[styles.cta, styles.ctaPrimary]} href="#experience">View experience</a></li>
            <li><a class={styles.cta} href={linkedIn} target="_blank" rel="noreferrer">LinkedIn</a></li>
            <li><a class={styles.cta} href="#contact">Contact</a></li>
          </ul>
        </header>
        <div class={styles.intro}>
          <ProfilePanel />
        </div>
      </div>
    </main>
    <script>
      import { bindAudioControls } from '../features/audio-experience/bind-audio-controls';
      import { guitarAudio } from '../features/audio-experience/audio-engine';
      import { bindGuitarNav, setActiveSection } from '../features/interactive-guitar/guitar-nav';
      import { initStringMotion, resetStrings } from '../features/interactive-guitar/guitar-motion';
      import { guitarStrings } from '../features/interactive-guitar/strings';
      import { getDefaultSection } from '../features/profile/profile';
      import { watchActiveSection } from '../features/profile/watch-active-section';

      const guitar: Element | null = document.querySelector('[data-guitar]');
      if (guitar instanceof HTMLElement) {
        initStringMotion(guitar, guitarStrings);
        bindGuitarNav({
          playSound: (stringIndex: number): void => {
            void guitarAudio.playString(stringIndex);
          },
        });
        setActiveSection(getDefaultSection().id);
        watchActiveSection(setActiveSection);

        // Below 860px the rotated SVG is decorative: StringNav carries the links,
        // so the SVG leaves the tab order and the accessibility tree.
        const mobile: MediaQueryList = window.matchMedia('(max-width: 859px)');
        const stage: HTMLElement | null = guitar.querySelector<HTMLElement>('[data-guitar-stage]');
        const syncInert = (): void => {
          if (stage) {
            stage.inert = mobile.matches;
          }
        };
        syncInert();
        mobile.addEventListener('change', syncInert);
      }

      const controls: Element | null = document.querySelector('[data-audio-controls]');
      if (controls instanceof HTMLElement) {
        bindAudioControls(controls, guitarAudio);
      }

      window.addEventListener('pagehide', (event: PageTransitionEvent): void => {
        resetStrings();
        if (event.persisted) {
          return;
        }
        void guitarAudio.dispose();
      });
    </script>
  </body>
</html>
