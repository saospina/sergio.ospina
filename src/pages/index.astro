---
// Self-hosted fonts: Latin subset, only the two weights the CSS uses.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import { getImage } from 'astro:assets';
import homeBackground from '../assets/home.jpeg';
import AudioControls from '../features/audio-experience/AudioControls.astro';
import Guitar from '../features/interactive-guitar/Guitar.astro';
import StringNav from '../features/interactive-guitar/StringNav.astro';
import ProfilePanel from '../features/profile/ProfilePanel.astro';
import { getCvSize } from '../features/profile/cv-file';
import {
  currentRole,
  cv,
  description,
  displayName,
  guitarCaption,
  headline,
  homeLocation,
  linkedIn,
  links,
  pageTitle,
  tagline,
} from '../features/profile/profile';
import SiteNotice from '../features/site-notice/SiteNotice.astro';
import { BASE, assetUrl } from '../shared/asset-url';
import { DownloadIcon } from '../shared/icons';
import styles from '../styles/home.module.css';

const canonical: string = new URL(BASE, Astro.site).href;
const cvSize: string = getCvSize();
// The photo sits under a 75% dark layer, so moderate quality is invisible.
// getImage() URLs already include the base path.
const [backgroundAvif, backgroundWebp] = await Promise.all([
  getImage({ src: homeBackground, format: 'avif', quality: 35 }),
  getImage({ src: homeBackground, format: 'webp', width: 1440, quality: 45 }),
]);
const backgroundStyle: string = [
  `--background-fallback: url('${backgroundWebp.src}')`,
  `--background-image: image-set(url('${backgroundAvif.src}') type('image/avif'), url('${backgroundWebp.src}') type('image/webp'))`,
].join('; ');
const person: string = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  jobTitle: currentRole.title,
  worksFor: { '@type': 'Organization', name: currentRole.company },
  address: {
    '@type': 'PostalAddress',
    addressLocality: homeLocation.city,
    addressCountry: homeLocation.countryCode,
  },
  url: canonical,
  sameAs: links.map((link) => link.href),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={person} />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-V3TGD1L0Z4');
          </script>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V3TGD1L0Z4"></script>
        </>
      )
    }
  </head>
  <body>
    <a class={styles.skip} href="#profile">Skip to profile</a>
    <SiteNotice />
    <main class={styles.page} style={backgroundStyle}>
      <div class={styles.instrument}>
        <Guitar />
        <p class={styles.caption}>{guitarCaption}</p>
        <AudioControls />
      </div>
      <StringNav />
      <div class={styles.content}>
        <header>
          <p class={styles.kicker}>{headline}</p>
          <h1 class={styles.title}>Antonio<br />Ospina</h1>
          <p class={styles.tagline}>{tagline}</p>
          <ul class={styles.ctas}>
            <li><a class:list={[styles.cta, styles.ctaPrimary]} href="#experience" data-track="cta" data-track-label="experience">View experience</a></li>
            <li>
              <a
                class={styles.cta}
                href={assetUrl(cv.path)}
                download={cv.fileName}
                type="application/pdf"
                data-cv-download
                data-track="cv"
                data-track-location="hero"
              >
                <Fragment set:html={DownloadIcon} />
                {cv.label}
                <span class={styles.ctaMeta}>PDF · {cvSize}</span>
              </a>
            </li>
            <li><a
                class={styles.cta}
                href={linkedIn.href}
                target="_blank"
                rel="noreferrer"
                data-track="social"
                data-track-label={linkedIn.label}
                data-track-location="hero"
              >
                {linkedIn.label}
              </a></li>
            <li><a class={styles.cta} href="#contact" data-track="cta" data-track-label="contact">Contact</a></li>
          </ul>
        </header>
        <div class={styles.intro}>
          <ProfilePanel />
        </div>
      </div>
    </main>
    <script>
      import { initAnalytics, track, trackFirstSound } from '../features/analytics/bind-analytics';
      import { bindAudioControls } from '../features/audio-experience/bind-audio-controls';
      import { guitarAudio } from '../features/audio-experience/audio-engine';
      import { bindGuitarNav, setActiveSection } from '../features/interactive-guitar/guitar-nav';
      import { initStringMotion, resetStrings } from '../features/interactive-guitar/guitar-motion';
      import { guitarStrings } from '../features/interactive-guitar/strings';
      import { getDefaultSection } from '../features/profile/profile';
      import { watchActiveSection } from '../features/profile/watch-active-section';

      const guitar: Element | null = document.querySelector('[data-guitar]');
      if (guitar instanceof HTMLElement) {
        initStringMotion(guitar, guitarStrings);
        bindGuitarNav({
          playSound: (stringIndex: number): void => {
            void guitarAudio.playString(stringIndex);
            trackFirstSound(guitarAudio.isAudible());
          },
        });
        setActiveSection(getDefaultSection().id);
        watchActiveSection(setActiveSection);

        // Below 860px the rotated SVG is decorative: StringNav carries the links,
        // so the SVG leaves the tab order and the accessibility tree.
        const mobile: MediaQueryList = window.matchMedia('(max-width: 859px)');
        const stage: HTMLElement | null = guitar.querySelector<HTMLElement>('[data-guitar-stage]');
        const syncInert = (): void => {
          if (stage) {
            stage.inert = mobile.matches;
          }
        };
        syncInert();
        mobile.addEventListener('change', syncInert);
      }

      const controls: Element | null = document.querySelector('[data-audio-controls]');
      if (controls instanceof HTMLElement) {
        bindAudioControls(controls, guitarAudio);
      }

      initAnalytics();
      guitarAudio.onUnavailable((): void => {
        track('audio_unavailable', {});
      });

      window.addEventListener('pagehide', (event: PageTransitionEvent): void => {
        resetStrings();
        if (event.persisted) {
          return;
        }
        void guitarAudio.dispose();
      });
    </script>
  </body>
</html>
