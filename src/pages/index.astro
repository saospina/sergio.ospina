---
import AudioControls from '../features/audio-experience/AudioControls.astro';
import Guitar from '../features/interactive-guitar/Guitar.astro';
import ProfilePanel from '../features/profile/ProfilePanel.astro';
import { description, displayName, getDefaultSection, links } from '../features/profile/profile';
import styles from '../styles/home.module.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const icons: Record<string, string> = {
  LinkedIn:
    'M6.5 8.2H3V21h3.5V8.2ZM4.7 3A2.1 2.1 0 1 0 4.7 7.2 2.1 2.1 0 0 0 4.7 3ZM21 13.7c0-3.8-2-5.8-4.8-5.8-2.2 0-3.1 1.2-3.7 2v-1.7H9V21h3.5v-6.3c0-1.7.3-3.4 2.5-3.4 2.1 0 2.1 2 2.1 3.5V21H21v-7.3Z',
  GitHub:
    'M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.6.9.6 1.8V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z',
  Medium:
    'M4 6.3 12.3 6.3 15.2 14 17.8 6.3H20v11.4h-3.6V8.9l-3.2 8.8h-1.8L8.2 9v6.7l2 2H4l2-2V8.3l-2-2Z',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{displayName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=Raleway" rel="stylesheet" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-V3TGD1L0Z4');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V3TGD1L0Z4"></script>
  </head>
  <body>
    <a class={styles.skip} href="#profile">Skip to profile</a>
    <main
      class={styles.page}
      style={`--background-image: url('${base}img/home.jpeg')`}
    >
      <div class={styles.instrument}>
        <Guitar />
        <AudioControls />
      </div>
      <div class={styles.content}>
        <header>
          <h1 class={styles.title}>{displayName}</h1>
          <hr class={styles.divider} />
          <ProfilePanel active={getDefaultSection()} />
        </header>

        <nav aria-label="Social media links">
          <ul class={styles.socialLinks}>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={icons[link.label]} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </main>
    <script>
      import { bindAudioControls } from '../features/audio-experience/bind-audio-controls';
      import { guitarAudio } from '../features/audio-experience/audio-engine';
      import { bindGuitar } from '../features/interactive-guitar/guitar-controller';
      import {
        animateContentTransition,
        animateString,
        initGuitarMotion,
        resetGuitarState,
        watchReducedMotion,
      } from '../features/interactive-guitar/guitar-motion';
      import { getDefaultSection, getSectionByStringIndex } from '../features/profile/profile';
      import { activateSection } from '../features/profile/section-view';

      const panel: Element | null = document.querySelector('[data-profile-panel]');
      if (panel instanceof HTMLElement) {
        panel.setAttribute('data-enhanced', '');
      }

      activateSection(getDefaultSection().id);
      watchReducedMotion();

      const guitar: Element | null = document.querySelector('[data-guitar]');
      if (guitar instanceof HTMLElement) {
        initGuitarMotion(guitar);
        bindGuitar(guitar, (stringIndex: number): void => {
          const section = getSectionByStringIndex(stringIndex);
          if (section) {
            activateSection(section.id);
            animateContentTransition(section.id);
          }
          animateString(stringIndex);
          void guitarAudio.playString(stringIndex);
        });
      }

      const controls: Element | null = document.querySelector('[data-audio-controls]');
      if (controls instanceof HTMLElement) {
        bindAudioControls(controls, guitarAudio);
      }

      window.addEventListener('pagehide', (event: PageTransitionEvent): void => {
        resetGuitarState();
        if (event.persisted) {
          return;
        }
        void guitarAudio.dispose();
      });
    </script>
  </body>
</html>
