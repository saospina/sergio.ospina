---
import styles from './site-notice.module.css';
---

<div class={styles.notice} role="note" data-site-notice>
  <p class={styles.text}>
    {/* compressHTML: 'jsx' drops whitespace that spans a line break; keep the space explicit. */}
    <strong>Under construction.</strong>{' '}
    This site is a work in progress and may have bugs. Thanks for your patience.
  </p>
</div>
