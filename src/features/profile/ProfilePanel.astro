---
import { ArrowIcon } from '../../shared/icons';
import { sections, type ProfileSection } from './profile';
import styles from './profile.module.css';
import AboutExtras from './sections/AboutExtras.astro';
import ContactExtras from './sections/ContactExtras.astro';
import ExperienceExtras from './sections/ExperienceExtras.astro';
import SkillsExtras from './sections/SkillsExtras.astro';
import WorkExtras from './sections/WorkExtras.astro';

// Content each section renders after its summary and body. Sections without
// an entry (interests) have only the shared shell.
const extras = {
  about: AboutExtras,
  experience: ExperienceExtras,
  skills: SkillsExtras,
  projects: WorkExtras,
  contact: ContactExtras,
};
type SectionExtras = (typeof extras)[keyof typeof extras];

function extrasFor(id: ProfileSection['id']): SectionExtras | undefined {
  return (extras as Partial<Record<ProfileSection['id'], SectionExtras>>)[id];
}

function paragraphs(body: string): string[] {
  return body.split('\n\n').filter((paragraph) => paragraph.length > 0);
}
---

<div id="profile" class={styles.panel} tabindex="-1">
  {
    sections.map((section: ProfileSection, index: number) => {
      const next: ProfileSection | undefined = sections[index + 1];
      const Extras: SectionExtras | undefined = extrasFor(section.id);
      return (
        <article
          id={section.id}
          data-section-id={section.id}
          class={styles.section}
          aria-labelledby={`${section.id}-title`}
        >
          <p class={styles.eyebrow}>{`0${section.stringIndex} · ${section.navLabel}`}</p>
          <h2 id={`${section.id}-title`} class={styles.title}>
            {section.title}
          </h2>
          <p class={styles.summary}>{section.shortDescription}</p>
          {section.points ? (
            <ul class={styles.bullets}>
              {section.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          ) : (
            section.body &&
            paragraphs(section.body).map((paragraph) => <p class={styles.body}>{paragraph}</p>)
          )}

          {Extras && <Extras />}

          {next && (
            <a class={styles.next} href={`#${next.id}`} data-track="next">
              <span class={styles.nextMeta}>{`Next · string 0${next.stringIndex}`}</span>
              <span class={styles.nextName}>{next.title}</span>
              <Fragment set:html={ArrowIcon} />
            </a>
          )}
        </article>
      );
    })
  }
</div>
