---
import {
  certifications,
  education,
  experience,
  links,
  sections,
  skills,
  type ProfileSection,
} from './profile';
import styles from './profile.module.css';

function paragraphs(body: string): string[] {
  return body.split('\n\n').filter((paragraph) => paragraph.length > 0);
}

const ArrowIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9"></path></svg>`;
---

<div id="profile" class={styles.panel} tabindex="-1">
  {
    sections.map((section: ProfileSection, index: number) => {
      const next: ProfileSection | undefined = sections[index + 1];
      const isPlaceholder: boolean = section.shortDescription === 'Placeholder';
      return (
        <article
          id={section.id}
          data-section-id={section.id}
          class:list={[styles.section, isPlaceholder && styles.placeholder]}
          aria-labelledby={`${section.id}-title`}
        >
          <p class={styles.eyebrow}>{`0${section.stringIndex} · ${section.note}`}</p>
          <h2 id={`${section.id}-title`} class={styles.title}>
            {section.title}
          </h2>
          <p class={styles.summary}>{section.shortDescription}</p>
          {paragraphs(section.body).map((paragraph) => (
            <p class={styles.body}>{paragraph}</p>
          ))}

          {section.id === 'about' && (
            <ul class={styles.pills}>
              {links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer" class={styles.pill}>
                    {link.label}
                    <Fragment set:html={ArrowIcon} />
                  </a>
                </li>
              ))}
            </ul>
          )}

          {section.id === 'skills' && (
            <div class={styles.groups}>
              {skills.map((group) => (
                <div>
                  <h3 class={styles.groupLabel}>{group.label}</h3>
                  <ul class={styles.list}>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}

          {section.id === 'experience' && (
            <div>
              {experience.map((job) => (
                <section class={styles.job}>
                  <h3 class={styles.groupLabel}>{job.company}</h3>
                  <p class={styles.meta}>{job.meta}</p>
                  {job.roles.map((role) => (
                    <div class={styles.role}>
                      <h4 class={styles.roleTitle}>{role.title}</h4>
                      {role.period && <p class={styles.meta}>{role.period}</p>}
                      {role.note && <p class={styles.meta}>{role.note}</p>}
                      {role.points.length > 0 && (
                        <ul class={styles.list}>
                          {role.points.map((point) => (
                            <li>{point}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </section>
              ))}
              <h3 class={styles.groupLabel}>Education</h3>
              {education.map((item) => (
                <div class={styles.role}>
                  <h4 class={styles.roleTitle}>{item.school}</h4>
                  <p class={styles.meta}>{item.credential}</p>
                  <p class={styles.meta}>{item.period}</p>
                </div>
              ))}
              <h3 class={styles.groupLabel}>Certifications</h3>
              <ul class={styles.list}>
                {certifications.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}

          {section.id === 'contact' && (
            <ul class={styles.links}>
              {links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}

          {next && (
            <a class={styles.next} href={`#${next.id}`}>
              <span class={styles.nextMeta}>{`Next string · 0${next.stringIndex} · ${next.note}`}</span>
              <span class={styles.nextName}>{next.title}</span>
              <Fragment set:html={ArrowIcon} />
            </a>
          )}
        </article>
      );
    })
  }
</div>
