---
import styles from './guitar.module.css';
import { guitarStrings, stringPath, type GuitarString } from './strings';

// The fingerboard tapers from 190-230 at the nut (y 150) to 184-236 at y 470.
const FRETS: readonly { y: number; left: number; right: number }[] = [
  182, 212, 240, 266, 290, 312, 333, 352, 370, 386, 401, 415,
].map((y: number) => ({
  y,
  left: Number((190 - ((y - 150) * 6) / 320).toFixed(2)),
  right: Number((230 + ((y - 150) * 6) / 320).toFixed(2)),
}));
const INLAY_POINTS: readonly { x: number; y: number }[] = [
  { x: 210, y: 226 },
  { x: 210, y: 278 },
  { x: 210, y: 322.5 },
  { x: 210, y: 361 },
  { x: 203, y: 408 },
  { x: 217, y: 408 },
];

const topLabels: readonly GuitarString[] = guitarStrings.filter(
  (string: GuitarString): boolean => string.side === 'right',
);
const bottomLabels: readonly GuitarString[] = guitarStrings.filter(
  (string: GuitarString): boolean => string.side === 'left',
);
---

<nav class={styles.guitar} aria-label="Sections" data-guitar>
  <ul class={`${styles.mobileLabels} ${styles.mobileLabelsTop}`} aria-hidden="true">
    {
      topLabels.map((string: GuitarString) => (
        <li>
          <a href={`#${string.sectionId}`} tabindex="-1" data-string-index={string.index} data-mobile-label>
            <span class={styles.mobileName}>{string.label}</span>
            <span class={styles.mobileNote}>{`0${string.index} · ${string.note}`}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class={styles.stage}>
  <svg class={styles.art} viewBox="0 0 420 780" focusable="false">
    <!-- body -->
    <path d="M175 438 C120 438 92 462 92 505 C92 545 118 560 118 585 C118 610 62 630 62 680 C62 730 130 752 210 752 C290 752 358 730 358 680 C358 630 302 610 302 585 C302 560 328 545 328 505 C328 462 300 438 245 438 Z" fill="#121714" stroke="#E9E4D8" stroke-width="1.5"></path>
    <path d="M178 446 C128 446 100 468 100 505 C100 543 126 558 126 585 C126 614 70 634 70 680 C70 724 134 744 210 744 C286 744 350 724 350 680 C350 634 294 614 294 585 C294 558 320 543 320 505 C320 468 292 446 242 446 Z" fill="none" stroke="#E9E4D8" stroke-opacity="0.25" stroke-width="1"></path>
    <!-- pickguard -->
    <path d="M250 585 C282 570 302 600 298 630 C294 660 264 668 248 650 Z" fill="none" stroke="#E9E4D8" stroke-opacity="0.3" stroke-width="1"></path>
    <!-- soundhole + rosette -->
    <circle cx="210" cy="560" r="46" fill="none" stroke="#E9E4D8" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 4"></circle>
    <circle cx="210" cy="560" r="40" fill="none" stroke="#E9E4D8" stroke-opacity="0.6" stroke-width="1"></circle>
    <circle cx="210" cy="560" r="34" fill="#070908" stroke="#E9E4D8" stroke-width="1.2"></circle>
    <!-- bridge -->
    <rect x="166" y="642" width="88" height="30" rx="7" fill="#121714" stroke="#E9E4D8" stroke-width="1.2"></rect>
    <line x1="182" y1="655" x2="238" y2="655" stroke="#E9E4D8" stroke-width="2"></line>
    <!-- headstock -->
    <path d="M190 150 L180 62 Q180 40 200 40 L220 40 Q240 40 240 62 L230 150 Z" fill="#121714" stroke="#E9E4D8" stroke-width="1.5"></path>
    <text x="210" y="58" text-anchor="middle" class={styles.brand}>AO</text>
    <!-- neck / fingerboard -->
    <path d="M190 150 L230 150 L236 470 L184 470 Z" fill="#161B18" stroke="#E9E4D8" stroke-width="1.5"></path>
    <line x1="189" y1="150" x2="231" y2="150" stroke="#E9E4D8" stroke-width="3"></line>
    <g stroke="#E9E4D8" stroke-opacity="0.45" stroke-width="1">
      {
        FRETS.map((fret) => (
          <line x1={fret.left} y1={fret.y} x2={fret.right} y2={fret.y} />
        ))
      }
    </g>
    <g fill="#E9E4D8" fill-opacity="0.5">
      {
        INLAY_POINTS.map((point) => (
          <circle cx={point.x} cy={point.y} r="2.5" />
        ))
      }
    </g>

    <!-- strings, tuners and labels: each one is a link to its section -->
    {
      guitarStrings.map((string: GuitarString) => {
        const isLeft: boolean = string.side === 'left';
        const shaftStartX: number = isLeft ? string.buttonX + 11 : string.buttonX - 11;
        const labelX: number = isLeft ? 140 : 280;
        const d: string = stringPath(string, 0);
        return (
          <a
            class={styles.string}
            href={`#${string.sectionId}`}
            aria-label={`${string.label}, string ${string.index}, ${string.note}`}
            data-guitar-string
            data-string-index={string.index}
            style={`--gauge: ${string.gauge}px`}
          >
            <path class={styles.hit} d={d} />
            <line
              class={styles.shaft}
              x1={shaftStartX}
              y1={string.postY}
              x2={string.shaftEndX}
              y2={string.postY}
            />
            <ellipse class={styles.button} cx={string.buttonX} cy={string.postY} rx="11" ry="6" />
            <circle class={styles.post} cx={string.postX} cy={string.postY} r="3.5" />
            <path class={styles.stringLine} d={d} data-string-path />
            <rect
              class={styles.halo}
              x={isLeft ? 34 : 272}
              y={string.labelY - 12}
              width="108"
              height="26"
              rx="4"
            />
            <text class={styles.name} x={labelX} y={string.labelY} text-anchor={isLeft ? 'end' : 'start'}>
              {string.label}
            </text>
            <text class={styles.note} x={labelX} y={string.labelY + 14} text-anchor={isLeft ? 'end' : 'start'}>
              {`0${string.index} · ${string.note}`}
            </text>
          </a>
        );
      })
    }

    <!-- sound hole -->
    <circle cx="140" cy="232" r="24" fill="rgba(0,0,0,0.6)" stroke="none"></circle>
    <circle cx="140" cy="232" r="24" fill="none" stroke="#E9E4D8" stroke-width="1.6"></circle>
    <circle cx="140" cy="232" r="28.5" fill="none" stroke="#E9E4D8" stroke-width="1.1" stroke-opacity="0.75"></circle>
    <circle cx="140" cy="232" r="31.5" fill="none" stroke="#E9E4D8" stroke-width="2" stroke-opacity="0.45" stroke-dasharray="3 5"></circle>
  </svg>
  </div>

  <ul class={`${styles.mobileLabels} ${styles.mobileLabelsBottom}`} aria-hidden="true">
    {
      bottomLabels.map((string: GuitarString) => (
        <li>
          <a href={`#${string.sectionId}`} tabindex="-1" data-string-index={string.index} data-mobile-label>
            <span class={styles.mobileName}>{string.label}</span>
            <span class={styles.mobileNote}>{`0${string.index} · ${string.note}`}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
